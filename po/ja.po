msgid "General"
msgstr "一般"

msgid "Desktop Widget"
msgstr "デスクトップウィジェット"

msgid "Plasma theme"
msgstr "Plasma テーマ"

msgid "Translucent"
msgstr "半透明"

msgid "Translucent light"
msgstr "半透明（明るい）"

msgid "Yellow"
msgstr "黄"

msgid "White"
msgstr "白"

msgid "Black"
msgstr "黒"

msgid "Red"
msgstr "赤"

msgid "Orange"
msgstr "オレンジ"

msgid "Green"
msgstr "緑"

msgid "Blue"
msgstr "青"

msgid "Pink"
msgstr "ピンク"

msgid "Custom colors"
msgstr "カスタムカラー"

msgid ""
"These settings apply when the widget is on the desktop. In a panel, the "
"widget uses the General settings."
msgstr ""
"これらの設定はウィジェットがデスクトップ上にあるときに適用されます。パネル内"
"では「一般」の設定が使われます。"

msgid "Colors:"
msgstr "色:"

msgid "Background color:"
msgstr "背景色:"

msgid "Background color"
msgstr "背景色"

msgid "Text color:"
msgstr "文字色:"

msgid "Text color"
msgstr "文字色"

msgid "Background opacity:"
msgstr "背景の不透明度:"

#, qt-format
msgid "%1 %"
msgstr "%1%"

msgid "Font size:"
msgstr "フォントサイズ:"

#, qt-format
msgid "%1 pt"
msgstr "%1 pt"

msgid "Show:"
msgstr "表示:"

msgid "New task field and Open in Browser button"
msgstr "新しいタスク欄と「ブラウザで開く」ボタン"

msgid "Preview:"
msgstr "プレビュー:"

msgid "A completed task"
msgstr "完了したタスク"

msgid "An open task"
msgstr "未完了のタスク"

msgid "Connection"
msgstr "接続"

#, qt-format
msgid ""
"Memos ToDo needs a server running UseMemos, the open-source, self-hosted "
"note service. Find out more at %1."
msgstr "Memos ToDo には、オープンソースのセルフホスト型メモサービス UseMemos のサーバーが必要です。詳しくは %1 をご覧ください。"

msgid "Server URL:"
msgstr "サーバーURL:"

msgid "The base URL of your Memos server"
msgstr "MemosサーバーのベースURL"

msgid "Access token:"
msgstr "アクセストークン:"

msgid "Your API Access Token (Bearer token not including 'Bearer ' prefix)"
msgstr ""
"APIアクセストークン ('Bearer ' プレフィックスを含まないベアラートークン)"

msgid ""
"All Memos ToDo widgets share the server URL and the access token. Each "
"widget has its own memo ID."
msgstr ""
"すべての Memos ToDo ウィジェットはサーバーURLとアクセストークンを共有します。"
"メモIDはウィジェットごとに設定します。"

msgid "Memo ID:"
msgstr "メモID:"

msgid "The ID of the memo you want to show (found in the memo URL or details)"
msgstr "表示したいメモのID (メモのURLまたは詳細にあります)"

msgid "Refresh interval:"
msgstr "更新間隔:"

#, qt-format
msgid "%1 minute"
msgid_plural "%1 minutes"
msgstr[0] "%1 分"

msgid "Popup"
msgstr "ポップアップ"

msgid "Popup font size:"
msgstr "ポップアップのフォントサイズ:"

msgid "Popup width:"
msgstr "ポップアップの幅:"

#, qt-format
msgid "%1 px"
msgstr "%1 px"

msgid "Show completed tasks in popup"
msgstr "ポップアップに完了したタスクを表示する"

msgid "Panel"
msgstr "パネル"

msgid "Panel font size:"
msgstr "パネルのフォントサイズ:"

msgid "Panel width:"
msgstr "パネルの幅:"

msgid "Use a fixed width"
msgstr "固定幅を使用する"

msgid "Show completed tasks in panel"
msgstr "パネルに完了したタスクを表示する"

msgid "Text cycle interval:"
msgstr "テキストの切り替え間隔:"

#, qt-format
msgid "%1 second"
msgid_plural "%1 seconds"
msgstr[0] "%1 秒"

msgid "Time to show each line before switching to the next"
msgstr "次の行に切り替えるまでの表示時間"

msgid "Panel slide duration:"
msgstr "パネルのスライド時間:"

#, qt-format
msgid "%1 ms"
msgstr "%1 ms"

msgid "0 ms turns the slide animation off."
msgstr "0 ms にするとスライドアニメーションが無効になります。"

msgid "Configure…"
msgstr "設定…"

msgid "Delete task"
msgstr "タスクを削除"

msgid "New task..."
msgstr "新しいタスク..."

msgid "Add task"
msgstr "タスクを追加"

msgid "Open in Browser"
msgstr "ブラウザで開く"

msgid "Please configure Server URL, Token and Memo ID in settings."
msgstr "設定でサーバーURL、トークン、メモIDを構成してください。"

msgid "Memo ID not set. Enter the ID of the memo to show in the settings."
msgstr "メモIDが未設定です。設定で表示するメモのIDを入力してください。"

msgid "Loading..."
msgstr "読み込み中..."

msgid "Configure Settings"
msgstr "設定を構成してください"

msgid "Memo ID not set"
msgstr "メモIDが未設定です"

msgid "Error"
msgstr "エラー"

msgid "Empty Memo"
msgstr "メモがありません"

msgid "Memos ToDo"
msgstr "Memos ToDo"

#, qt-format
msgid "%1 open task"
msgid_plural "%1 open tasks"
msgstr[0] "未完了のタスク %1 件"

msgid "Refresh"
msgstr "更新"

msgid "Connection Error"
msgstr "接続エラー"

msgid "Memo not found. Check the memo ID in the settings."
msgstr "メモが見つかりません。設定のメモIDを確認してください。"

msgid "Access token rejected. Check the token in the settings."
msgstr "アクセストークンが拒否されました。設定のトークンを確認してください。"

#, qt-format
msgid "Error %1"
msgstr "エラー %1"

msgid "Parse Error"
msgstr "解析エラー"
