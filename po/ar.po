msgid "General"
msgstr "عام"

msgid "Connection"
msgstr "الاتصال"

msgid "Server URL:"
msgstr "عنوان URL للخادم:"

msgid "The base URL of your Memos server"
msgstr "عنوان URL الأساسي لخادم Memos الخاص بك"

msgid "Access token:"
msgstr "رمز الوصول:"

msgid "Your API Access Token (Bearer token not including 'Bearer ' prefix)"
msgstr "رمز الوصول إلى واجهة برمجة التطبيقات (رمز Bearer بدون بادئة 'Bearer ')"

msgid "Memo ID:"
msgstr "معرف المذكرة:"

msgid "The ID of the memo you want to show (found in the memo URL or details)"
msgstr "معرف المذكرة التي تريد إظهارها (موجود في عنوان URL للمذكرة أو تفاصيلها)"

msgid "Refresh interval:"
msgstr "فترة التحديث:"

msgid "%1 minute"
msgid_plural "%1 minutes"
msgstr[0] "%1 دقيقة"
msgstr[1] "دقيقة واحدة"
msgstr[2] "دقيقتان"
msgstr[3] "%1 دقائق"
msgstr[4] "%1 دقيقة"
msgstr[5] "%1 دقيقة"

msgid "Popup"
msgstr "القائمة المنبثقة"

msgid "Popup font size:"
msgstr "حجم خط القائمة المنبثقة:"

msgid "%1 pt"
msgstr "%1 نقطة"

msgid "Popup width:"
msgstr "عرض القائمة المنبثقة:"

msgid "%1 px"
msgstr "%1 بكسل"

msgid "Show completed tasks in popup"
msgstr "إظهار المهام المكتملة في القائمة المنبثقة"

msgid "Panel"
msgstr "الشريط"

msgid "Panel font size:"
msgstr "حجم خط الشريط:"

msgid "Panel width:"
msgstr "عرض الشريط:"

msgid "Use a fixed width"
msgstr "استخدام عرض ثابت"

msgid "Show completed tasks in panel"
msgstr "إظهار المهام المكتملة في الشريط"

msgid "Text cycle interval:"
msgstr "فترة دورة النص:"

msgid "%1 second"
msgid_plural "%1 seconds"
msgstr[0] "%1 ثانية"
msgstr[1] "ثانية واحدة"
msgstr[2] "ثانيتان"
msgstr[3] "%1 ثوانٍ"
msgstr[4] "%1 ثانية"
msgstr[5] "%1 ثانية"

msgid "Time to show each line before switching to the next"
msgstr "الوقت لعرض كل سطر قبل الانتقال إلى التالي"

msgid "Panel slide duration:"
msgstr "مدة انزلاق الشريط:"

msgid "%1 ms"
msgstr "%1 مللي ثانية"

msgid "0 ms turns the slide animation off."
msgstr "القيمة 0 مللي ثانية توقف حركة الانزلاق."

msgid "Configure…"
msgstr "تهيئة…"

msgid "Delete task"
msgstr "حذف المهمة"

msgid "New task..."
msgstr "مهمة جديدة..."

msgid "Add task"
msgstr "إضافة مهمة"

msgid "Open in Browser"
msgstr "فتح في المتصفح"

msgid "Loading..."
msgstr "جاري التحميل..."

msgid "Configure Settings"
msgstr "اضبط الإعدادات"

msgid "Error"
msgstr "خطأ"

msgid "Empty Memo"
msgstr "مذكرة فارغة"

msgid "Memos ToDo"
msgstr "Memos ToDo"

msgid "Please configure Server URL, Token and Memo ID in settings."
msgstr "يرجى ضبط عنوان URL للخادم والرمز ومعرف المذكرة في الإعدادات."

msgid "%1 open task"
msgid_plural "%1 open tasks"
msgstr[0] "لا مهام مفتوحة"
msgstr[1] "مهمة مفتوحة واحدة"
msgstr[2] "مهمتان مفتوحتان"
msgstr[3] "%1 مهام مفتوحة"
msgstr[4] "%1 مهمة مفتوحة"
msgstr[5] "%1 مهمة مفتوحة"

msgid "Refresh"
msgstr "تحديث"

msgid "Connection Error"
msgstr "خطأ في الاتصال"

msgid "Error %1"
msgstr "خطأ %1"

msgid "Parse Error"
msgstr "خطأ في التحليل"
