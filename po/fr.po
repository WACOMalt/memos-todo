msgid "General"
msgstr "Général"

msgid "Connection"
msgstr "Connexion"

msgid "Server URL:"
msgstr "URL du serveur :"

msgid "The base URL of your Memos server"
msgstr "L'URL de base de votre serveur Memos"

msgid "Access token:"
msgstr "Jeton d'accès :"

msgid "Your API Access Token (Bearer token not including 'Bearer ' prefix)"
msgstr "Votre jeton d'accès API (jeton Bearer sans le préfixe 'Bearer ')"

msgid "Memo ID:"
msgstr "ID du mémo :"

msgid "The ID of the memo you want to show (found in the memo URL or details)"
msgstr "L'ID du mémo que vous souhaitez afficher (se trouve dans l'URL ou les détails du mémo)"

msgid "Refresh interval:"
msgstr "Intervalle de rafraîchissement :"

msgid "%1 minute"
msgid_plural "%1 minutes"
msgstr[0] "%1 minute"
msgstr[1] "%1 minutes"

msgid "Popup"
msgstr "Menu"

msgid "Popup font size:"
msgstr "Taille de la police du menu :"

msgid "%1 pt"
msgstr "%1 pt"

msgid "Popup width:"
msgstr "Largeur du menu :"

msgid "%1 px"
msgstr "%1 px"

msgid "Show completed tasks in popup"
msgstr "Afficher les tâches terminées dans le menu"

msgid "Panel"
msgstr "Tableau de bord"

msgid "Panel font size:"
msgstr "Taille de la police du tableau de bord :"

msgid "Panel width:"
msgstr "Largeur du tableau de bord :"

msgid "Use a fixed width"
msgstr "Utiliser une largeur fixe"

msgid "Show completed tasks in panel"
msgstr "Afficher les tâches terminées dans le tableau de bord"

msgid "Text cycle interval:"
msgstr "Intervalle de défilement du texte :"

msgid "%1 second"
msgid_plural "%1 seconds"
msgstr[0] "%1 seconde"
msgstr[1] "%1 secondes"

msgid "Time to show each line before switching to the next"
msgstr "Temps d'affichage de chaque ligne avant de passer à la suivante"

msgid "Panel slide duration:"
msgstr "Durée du glissement du tableau de bord :"

msgid "%1 ms"
msgstr "%1 ms"

msgid "0 ms turns the slide animation off."
msgstr "0 ms désactive l'animation de glissement."

msgid "Configure…"
msgstr "Configurer…"

msgid "Delete task"
msgstr "Supprimer la tâche"

msgid "New task..."
msgstr "Nouvelle tâche..."

msgid "Add task"
msgstr "Ajouter la tâche"

msgid "Open in Browser"
msgstr "Ouvrir dans le navigateur"

msgid "Loading..."
msgstr "Chargement..."

msgid "Configure Settings"
msgstr "Configurer les paramètres"

msgid "Error"
msgstr "Erreur"

msgid "Empty Memo"
msgstr "Mémo vide"

msgid "Memos ToDo"
msgstr "Memos ToDo"

msgid "Please configure Server URL, Token and Memo ID in settings."
msgstr "Veuillez configurer l'URL du serveur, le jeton et l'ID du mémo dans les paramètres."

msgid "%1 open task"
msgid_plural "%1 open tasks"
msgstr[0] "%1 tâche ouverte"
msgstr[1] "%1 tâches ouvertes"

msgid "Refresh"
msgstr "Actualiser"

msgid "Connection Error"
msgstr "Erreur de connexion"

msgid "Error %1"
msgstr "Erreur %1"

msgid "Parse Error"
msgstr "Erreur d'analyse"
