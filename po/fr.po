msgid "General"
msgstr "Général"

msgid "Desktop Widget"
msgstr "Widget de bureau"

msgid "Plasma theme"
msgstr "Thème Plasma"

msgid "Translucent"
msgstr "Translucide"

msgid "Translucent light"
msgstr "Translucide clair"

msgid "Yellow"
msgstr "Jaune"

msgid "White"
msgstr "Blanc"

