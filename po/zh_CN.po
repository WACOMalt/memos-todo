msgid "General"
msgstr "常规"

msgid "Desktop Widget"
msgstr "桌面小部件"

msgid "Plasma theme"
msgstr "Plasma 主题"

msgid "Translucent"
msgstr "半透明"

msgid "Translucent light"
msgstr "半透明（浅色）"

msgid "Yellow"
msgstr "黄色"

msgid "White"
msgstr "白色"

msgid "Black"
msgstr "黑色"

msgid "Red"
msgstr "红色"

msgid "Orange"
msgstr "橙色"

msgid "Green"
msgstr "绿色"

msgid "Blue"
msgstr "蓝色"

msgid "Pink"
msgstr "粉色"

msgid "Custom colors"
msgstr "自定义颜色"

msgid ""
"These settings apply when the widget is on the desktop. In a panel, the "
"widget uses the General settings."
msgstr "这些设置在小部件位于桌面上时生效。在面板中，小部件使用“常规”设置。"

msgid "Colors:"
msgstr "颜色："

msgid "Background color:"
msgstr "背景颜色："

msgid "Background color"
msgstr "背景颜色"

msgid "Text color:"
msgstr "文字颜色："

msgid "Text color"
msgstr "文字颜色"

msgid "Background opacity:"
msgstr "背景不透明度："

#, qt-format
msgid "%1 %"
msgstr "%1%"

msgid "Font size:"
msgstr "字体大小："

#, qt-format
msgid "%1 pt"
msgstr "%1 磅"

msgid "Show:"
msgstr "显示："

msgid "New task field and Open in Browser button"
msgstr "新任务输入框和“在浏览器中打开”按钮"

msgid "Preview:"
msgstr "预览："

msgid "A completed task"
msgstr "已完成的任务"

msgid "An open task"
msgstr "未完成的任务"

msgid "Connection"
msgstr "连接"

#, qt-format
msgid ""
"Memos ToDo needs a server running UseMemos, the open-source, self-hosted "
"note service. Find out more at %1."
msgstr "Memos ToDo 需要运行 UseMemos 的服务器，这是一款开源、自托管的笔记服务。了解更多请访问 %1。"

msgid "Server URL:"
msgstr "服务器 URL："

msgid "The base URL of your Memos server"
msgstr "Memos 服务器的基础 URL"

msgid "Access token:"
msgstr "访问令牌："

msgid "Your API Access Token (Bearer token not including 'Bearer ' prefix)"
msgstr "您的 API 访问令牌 (不包含 'Bearer ' 前缀的 Bearer 令牌)"

msgid ""
"All Memos ToDo widgets share the server URL and the access token. Each "
"widget has its own memo ID."
msgstr ""
"所有 Memos ToDo 小部件共享服务器 URL 和访问令牌。每个小部件有自己的备忘录 "
"ID。"

msgid "Memo ID:"
msgstr "备忘录 ID："

msgid "The ID of the memo you want to show (found in the memo URL or details)"
msgstr "您想要显示的备忘录 ID (在备忘录 URL 或详情中可以找到)"

msgid "Refresh interval:"
msgstr "刷新间隔："

#, qt-format
msgid "%1 minute"
msgid_plural "%1 minutes"
msgstr[0] "%1 分钟"

msgid "Popup"
msgstr "弹窗"

msgid "Popup font size:"
msgstr "弹窗字体大小："

msgid "Popup width:"
msgstr "弹窗宽度："

#, qt-format
msgid "%1 px"
msgstr "%1 像素"

msgid "Show completed tasks in popup"
msgstr "在弹窗中显示已完成的任务"

msgid "Panel"
msgstr "面板"

msgid "Panel font size:"
msgstr "面板字体大小："

msgid "Panel width:"
msgstr "面板宽度："

msgid "Use a fixed width"
msgstr "使用固定宽度"

msgid "Show completed tasks in panel"
msgstr "在面板中显示已完成的任务"

msgid "Text cycle interval:"
msgstr "文本循环间隔："

#, qt-format
msgid "%1 second"
msgid_plural "%1 seconds"
msgstr[0] "%1 秒"

msgid "Time to show each line before switching to the next"
msgstr "切换到下一行之前的显示时间"

msgid "Panel slide duration:"
msgstr "面板滑动持续时间："

#, qt-format
msgid "%1 ms"
msgstr "%1 毫秒"

msgid "0 ms turns the slide animation off."
msgstr "设为 0 毫秒可关闭滑动动画。"

msgid "Configure…"
msgstr "配置…"

msgid "Delete task"
msgstr "删除任务"

msgid "New task..."
msgstr "新任务..."

msgid "Add task"
msgstr "添加任务"

msgid "Open in Browser"
msgstr "在浏览器中打开"

msgid "Please configure Server URL, Token and Memo ID in settings."
msgstr "请在设置中配置服务器 URL、令牌和备忘录 ID。"

msgid "Memo ID not set. Enter the ID of the memo to show in the settings."
msgstr "未设置备忘录 ID。请在设置中输入要显示的备忘录 ID。"

msgid "Loading..."
msgstr "加载中..."

msgid "Configure Settings"
msgstr "请配置设置"

msgid "Memo ID not set"
msgstr "未设置备忘录 ID"

msgid "Error"
msgstr "错误"

msgid "Empty Memo"
msgstr "空备忘录"

msgid "Memos ToDo"
msgstr "Memos ToDo"

#, qt-format
msgid "%1 open task"
msgid_plural "%1 open tasks"
msgstr[0] "%1 个未完成的任务"

msgid "Refresh"
msgstr "刷新"

msgid "Connection Error"
msgstr "连接错误"

msgid "Memo not found. Check the memo ID in the settings."
msgstr "找不到备忘录。请检查设置中的备忘录 ID。"

msgid "Access token rejected. Check the token in the settings."
msgstr "访问令牌被拒绝。请检查设置中的令牌。"

#, qt-format
msgid "Error %1"
msgstr "错误 %1"

msgid "Parse Error"
msgstr "解析错误"
