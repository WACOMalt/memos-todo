msgstr "पृष्ठभूमि अपारदर्शिता:"

#, qt-format
msgid "%1 %"
msgstr "%1%"

msgid "Font size:"
msgstr "फ़ॉन्ट आकार:"

#, qt-format
msgid "%1 pt"
msgstr "%1 pt"

msgid "Show:"
msgstr "दिखाएं:"

msgid "New task field and Open in Browser button"
msgstr "नया कार्य फ़ील्ड और ब्राउज़र में खोलें बटन"

msgid "Preview:"
msgstr "पूर्वावलोकन:"

msgid "A completed task"
msgstr "एक पूर्ण कार्य"

msgid "An open task"
msgstr "एक खुला कार्य"

msgid "Connection"
msgstr "कनेक्शन"

#, qt-format
msgid ""
"Memos ToDo needs a server running UseMemos, the open-source, self-hosted "
"note service. Find out more at %1."
msgstr "Memos ToDo को UseMemos चलाने वाले सर्वर की ज़रूरत है, जो एक ओपन-सोर्स, सेल्फ़-होस्टेड नोट सेवा है। अधिक जानकारी के लिए %1 देखें।"

msgid "Server URL:"
msgstr "सर्वर URL:"

msgid "The base URL of your Memos server"
msgstr "आपके मेमो सर्वर का आधार URL"

msgid "Access token:"
msgstr "एक्सेस टोकन:"

msgid "Your API Access Token (Bearer token not including 'Bearer ' prefix)"
msgstr "आपका API एक्सेस टोकन (Bearer टोकन जिसमें 'Bearer ' उपसर्ग शामिल नहीं है)"

msgid ""
"All Memos ToDo widgets share the server URL and the access token. Each "
"widget has its own memo ID."
msgstr ""
"सभी Memos ToDo विजेट सर्वर URL और एक्सेस टोकन साझा करते हैं। हर विजेट की अपनी मेमो "
"आईडी होती है।"

msgid "Memo ID:"
msgstr "मेमो आईडी:"

msgid "The ID of the memo you want to show (found in the memo URL or details)"
msgstr "उस मेमो की आईडी जिसे आप दिखाना चाहते हैं (मेमो URL या विवरण में पाया जाता है)"

msgid "Refresh interval:"
msgstr "ताज़ा करने का अंतराल:"

#, qt-format
msgid "%1 minute"
msgid_plural "%1 minutes"
msgstr[0] "%1 मिनट"
msgstr[1] "%1 मिनट"

msgid "Popup"
msgstr "पॉपअप"

msgid "Popup font size:"
msgstr "पॉपअप फ़ॉन्ट आकार:"

msgid "Popup width:"
msgstr "पॉपअप चौड़ाई:"

#, qt-format
msgid "%1 px"
msgstr "%1 px"

msgid "Show completed tasks in popup"
msgstr "पॉपअप में पूर्ण किए गए कार्य दिखाएं"

msgid "Panel"
msgstr "पैनल"

msgid "Panel font size:"
msgstr "पैनल फ़ॉन्ट आकार:"

msgid "Panel width:"
msgstr "पैनल चौड़ाई:"

msgid "Use a fixed width"
msgstr "निश्चित चौड़ाई का उपयोग करें"

msgid "Show completed tasks in panel"
msgstr "पैनल में पूर्ण किए गए कार्य दिखाएं"

msgid "Text cycle interval:"
msgstr "टेक्स्ट साइकिल अंतराल:"

#, qt-format
msgid "%1 second"
msgid_plural "%1 seconds"
msgstr[0] "%1 सेकंड"
msgstr[1] "%1 सेकंड"

msgid "Time to show each line before switching to the next"
msgstr "अगली पंक्ति पर जाने से पहले प्रत्येक पंक्ति दिखाने का समय"

msgid "Panel slide duration:"
msgstr "पैनल स्लाइड अवधि:"

#, qt-format
msgid "%1 ms"
msgstr "%1 मि.से."

msgid "0 ms turns the slide animation off."
msgstr "0 मि.से. पर स्लाइड एनीमेशन बंद हो जाता है।"

msgid "Configure…"
msgstr "कॉन्फ़िगर करें…"

msgid "Delete task"
msgstr "कार्य हटाएं"

msgid "New task..."
msgstr "नया कार्य..."

msgid "Add task"
msgstr "कार्य जोड़ें"

msgid "Open in Browser"
msgstr "ब्राउज़र में खोलें"

msgid "Please configure Server URL, Token and Memo ID in settings."
msgstr "कृपया सेटिंग्स में सर्वर URL, टोकन और मेमो आईडी कॉन्फ़िगर करें।"

msgid "Memo ID not set. Enter the ID of the memo to show in the settings."
msgstr "मेमो आईडी सेट नहीं है। सेटिंग्स में दिखाने वाले मेमो की आईडी दर्ज करें।"

msgid "Loading..."
msgstr "लोड हो रहा है..."

msgid "Configure Settings"
msgstr "सेटिंग्स कॉन्फ़िगर करें"

msgid "Memo ID not set"
msgstr "मेमो आईडी सेट नहीं है"

msgid "Error"
msgstr "त्रुटि"

msgid "Empty Memo"
msgstr "खाली मेमो"

msgid "Memos ToDo"
msgstr "Memos ToDo"

#, qt-format
msgid "%1 open task"
msgid_plural "%1 open tasks"
msgstr[0] "%1 खुला कार्य"
msgstr[1] "%1 खुले कार्य"

msgid "Refresh"
msgstr "ताज़ा करें"

msgid "Connection Error"
msgstr "कनेक्शन त्रुटि"

msgid "Memo not found. Check the memo ID in the settings."
msgstr "मेमो नहीं मिला। सेटिंग्स में मेमो आईडी जांचें।"

msgid "Access token rejected. Check the token in the settings."
msgstr "एक्सेस टोकन अस्वीकार किया गया। सेटिंग्स में टोकन जांचें।"

#, qt-format
msgid "Error %1"
msgstr "त्रुटि %1"

msgid "Parse Error"
msgstr "पार्स त्रुटि"
