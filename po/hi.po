msgid ""
"These settings apply when the widget is on the desktop. In a panel, the "
"widget uses the General settings."
msgstr ""
"ये सेटिंग्स तब लागू होती हैं जब विजेट डेस्कटॉप पर होता है। पैनल में, विजेट सामान्य सेटिंग्स का "
"उपयोग करता है।"

msgid "Colors:"
msgstr "रंग:"

msgid "Background color:"
msgstr "पृष्ठभूमि रंग:"

msgid "Background color"
msgstr "पृष्ठभूमि रंग"

msgid "Text color:"
msgstr "टेक्स्ट रंग:"

msgid "Text color"
msgstr "टेक्स्ट रंग"

