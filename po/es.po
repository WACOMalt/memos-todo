msgstr "%1 px"

msgid "Show completed tasks in popup"
msgstr "Mostrar tareas completadas en el menú"

msgid "Panel"
msgstr "Panel"

msgid "Panel font size:"
msgstr "Tamaño de fuente del panel:"

msgid "Panel width:"
msgstr "Ancho del panel:"

msgid "Use a fixed width"
msgstr "Usar un ancho fijo"

msgid "Show completed tasks in panel"
msgstr "Mostrar tareas completadas en el panel"

msgid "Text cycle interval:"
msgstr "Intervalo de ciclo de texto:"

